# Application Configuration
APP_NAME=MedRescue AI Backend
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default, PostgreSQL compatible)
# SQLite: sqlite:///./medrescue.db
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/medrescue
DATABASE_URL=sqlite:///./medrescue.db

# Security & JWT Configuration
# Generate a secure secret in production: openssl rand -hex 32
SECRET_KEY=medrescue_super_secret_jwt_key_change_in_production_2026_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Rescue Engine & Logistics Defaults
DEFAULT_DELIVERY_COST_PER_KM=15.0
DEFAULT_FIXED_DELIVERY_CHARGE=500.0
MIN_SHELF_LIFE_DAYS=30
MAX_DELIVERY_RADIUS_KM=800.0
OSRM_ROUTING_URL=http://router.project-osrm.org

# Optional grounded explanation providers. Keep keys on the backend only.
EXPLAINER_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Online medicine checkout (Razorpay). Keep these keys on the server only.
# Use Razorpay test keys while developing; configure a webhook for /api/shop/webhook
# with the `payment.captured` event and set its signing secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
